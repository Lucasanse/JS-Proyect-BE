{
  "info": {
    "name": "Catalogo de productos",
    "description": "Pruebas de los endpoints del catalogo: listado paginado, filtros, detalle, categorias y marcas.\n\nAntes de correrla: base cargada con el seed (npx prisma migrate reset) y servidor levantado (npm run dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:3000"
    },
    {
      "key": "baseUrl",
      "value": "{{host}}/api"
    },
    {
      "key": "idComponente",
      "value": ""
    },
    {
      "key": "idNoComponente",
      "value": ""
    },
    {
      "key": "idSinStock",
      "value": ""
    },
    {
      "key": "idCategoriaInsumos",
      "value": ""
    },
    {
      "key": "idCategoriaPerifericos",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Test comun a todas las requests",
          "pm.test('Responde JSON', () => pm.response.to.be.json);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "url": "{{host}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "  pm.test('Status 200', () => pm.response.to.have.status(200));",
              "  pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Filtros",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const body = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Devuelve un array con id, nombre y cantidadProductos', () => {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach((c) => pm.expect(c).to.have.all.keys('id', 'nombre', 'cantidadProductos'));",
                  "  });",
                  "  pm.test('Incluye Computadoras, Insumos y Perifericos', () => {",
                  "    const nombres = body.map((c) => c.nombre);",
                  "    pm.expect(nombres).to.include.members(['Computadoras', 'Insumos', 'Perifericos']);",
                  "  });",
                  "",
                  "  // Guarda ids para las pruebas de filtros",
                  "  pm.collectionVariables.set('idCategoriaInsumos', body.find((c) => c.nombre === 'Insumos').id);",
                  "  pm.collectionVariables.set('idCategoriaPerifericos', body.find((c) => c.nombre === 'Perifericos').id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar marcas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/marcas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const body = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Devuelve marcas con nombre y cantidadProductos', () => {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach((m) => pm.expect(m).to.have.all.keys('nombre', 'cantidadProductos'));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar marcas de una categoria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/marcas?categoria={{idCategoriaPerifericos}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "marcas"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "{{idCategoriaPerifericos}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const body = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Solo marcas de perifericos (incluye Logitech, no AMD)', () => {",
                  "    const nombres = body.map((m) => m.nombre);",
                  "    pm.expect(nombres).to.include('Logitech');",
                  "    pm.expect(nombres).to.not.include('AMD');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Listado de productos",
      "item": [
        {
          "name": "Listar productos (por defecto)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/productos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const body = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Tiene data y paginacion', () => pm.expect(body).to.have.all.keys('data', 'paginacion'));",
                  "  pm.test('Pagina 1 con limit 12 por defecto', () => {",
                  "    pm.expect(body.paginacion.page).to.eql(1);",
                  "    pm.expect(body.paginacion.limit).to.eql(12);",
                  "    pm.expect(body.data.length).to.be.at.most(12);",
                  "    pm.expect(body.paginacion.hasPrev).to.eql(false);",
                  "  });",
                  "  pm.test('Cada producto tiene la forma esperada', () => {",
                  "    body.data.forEach((p) => {",
                  "      pm.expect(p).to.include.keys('id', 'nombre', 'descripcion', 'marca', 'precio', 'stock', 'disponible', 'categoria', 'esComponentePC', 'tipoComponente');",
                  "      pm.expect(p.precio).to.be.a('number');",
                  "      pm.expect(p.disponible).to.eql(p.stock > 0);",
                  "    });",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar todos (limit 50) y guardar ids de prueba",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const { data } = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "  const componente = data.find((p) => p.esComponentePC && p.stock > 0);",
                  "  const noComponente = data.find((p) => !p.esComponentePC);",
                  "  const sinStock = data.find((p) => p.stock === 0);",
                  "",
                  "  pm.test('Hay componentes de PC, otros productos y al menos uno sin stock', () => {",
                  "    pm.expect(componente, 'componente').to.exist;",
                  "    pm.expect(noComponente, 'no componente').to.exist;",
                  "    pm.expect(sinStock, 'sin stock').to.exist;",
                  "  });",
                  "",
                  "  // Se usan en las pruebas de detalle",
                  "  pm.collectionVariables.set('idComponente', componente.id);",
                  "  pm.collectionVariables.set('idNoComponente', noComponente.id);",
                  "  pm.collectionVariables.set('idSinStock', sinStock.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginacion (page 2, limit 5)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?page=2&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const { data, paginacion } = pm.response.json();",
                  "  pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "  pm.test('Devuelve la pagina 2 con 5 productos', () => {",
                  "    pm.expect(paginacion.page).to.eql(2);",
                  "    pm.expect(data.length).to.eql(5);",
                  "    pm.expect(paginacion.hasPrev).to.eql(true);",
                  "    pm.expect(paginacion.totalPages).to.eql(Math.ceil(paginacion.total / 5));",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagina fuera de rango (page 99)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?page=99",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "99"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "  const { data, paginacion } = pm.response.json();",
                  "  pm.test('Status 200 con data vacia', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(data).to.be.empty;",
                  "    pm.expect(paginacion.hasNext).to.eql(false);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Busqueda y filtros",
