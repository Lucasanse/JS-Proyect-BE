          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/productos?orden=precio_desc&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
