{
  "info": {
    "name": "E-commerce PC - JS-Proyect-BE",
    "description": "Coleccion de endpoints para el backend de e-commerce de computacion (Express + Prisma + PostgreSQL).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "idIdioma", "value": "1" },
    { "key": "idCategoria", "value": "" },
    { "key": "idProducto", "value": "" },
    { "key": "idProductoComponente", "value": "" },
    { "key": "idTraduccion", "value": "" },
    { "key": "idItemCarrito", "value": "" },
    { "key": "idVenta", "value": "" },
    { "key": "idSolicitud", "value": "" },
    { "key": "idPreset", "value": "" },
    { "key": "idComponentePreset", "value": "" },
    { "key": "idUsuario", "value": "" },
    { "key": "idNotificacion", "value": "" },
    { "key": "resetToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Cliente de Prueba\",\n  \"correo\": \"cliente@test.com\",\n  \"password\": \"Cliente123!\",\n  \"idIdioma\": {{idIdioma}},\n  \"direccion\": \"Calle Falsa 123\",\n  \"telefono\": \"1122334455\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('idUsuario', data.usuario.idUsuario);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin (seed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@ecommerce.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@test.com\",\n  \"password\": \"Cliente123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        },
        {
          "name": "Olvide password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/olvide-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"cliente@test.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().resetToken) {",
                  "  pm.collectionVariables.set('resetToken', pm.response.json().resetToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resetear password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/resetear-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"nuevaPassword\": \"NuevaPass123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        { "name": "Mi perfil", "request": { "method": "GET", "url": "{{baseUrl}}/usuarios/me" } },
        {
          "name": "Actualizar mi perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/usuarios/me",
            "body": { "mode": "raw", "raw": "{\n  \"telefono\": \"1199998888\"\n}" }
          }
        },
        { "name": "Listar usuarios (admin)", "request": { "method": "GET", "url": "{{baseUrl}}/usuarios" } },
        {
          "name": "Obtener usuario por id (admin)",
          "request": { "method": "GET", "url": "{{baseUrl}}/usuarios/{{idUsuario}}" }
        },
        {
          "name": "Actualizar usuario (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/usuarios/{{idUsuario}}",
            "body": { "mode": "raw", "raw": "{\n  \"cargo\": \"Soporte tecnico\"\n}" }
          }
        },
        {
          "name": "Eliminar usuario (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/usuarios/{{idUsuario}}" }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        { "name": "Listar categorias", "request": { "method": "GET", "url": "{{baseUrl}}/categorias" } },
        {
          "name": "Obtener categoria por id",
          "request": { "method": "GET", "url": "{{baseUrl}}/categorias/{{idCategoria}}" }
        },
        {
          "name": "Crear categoria (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categorias",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Procesadores\",\n  \"tipo\": \"COMPONENTE\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idCategoria', pm.response.json().idCategoria);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar categoria (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/categorias/{{idCategoria}}",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Procesadores AMD/Intel\"\n}" }
          }
        },
        {
          "name": "Eliminar categoria (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/categorias/{{idCategoria}}" }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        { "name": "Listar productos", "request": { "method": "GET", "url": "{{baseUrl}}/productos" } },
        {
          "name": "Obtener producto por id",
          "request": { "method": "GET", "url": "{{baseUrl}}/productos/{{idProducto}}" }
        },
        {
          "name": "Crear producto (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": {{idCategoria}},\n  \"nombre\": \"Mouse Gamer\",\n  \"marca\": \"Logitech\",\n  \"precio\": 25000.50,\n  \"stock\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idProducto', pm.response.json().idProducto);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar producto (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/{{idProducto}}",
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 15\n}" }
          }
        },
        {
          "name": "Eliminar producto (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/productos/{{idProducto}}" }
        },
        {
          "name": "Listar componentes PC (filtro tipoComponente)",
          "request": { "method": "GET", "url": "{{baseUrl}}/productos/componentes?tipoComponente=CPU" }
        },
        {
          "name": "Crear componente PC (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/componentes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCategoria\": {{idCategoria}},\n  \"nombre\": \"Ryzen 5 5600X\",\n  \"marca\": \"AMD\",\n  \"precio\": 150000,\n  \"stock\": 8,\n  \"tipoComponente\": \"CPU\",\n  \"socket\": \"AM4\",\n  \"wattsRequeridos\": 65\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idProductoComponente', pm.response.json().idProducto);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar componente PC (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/componentes/{{idProductoComponente}}",
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 12\n}" }
          }
        },
        {
          "name": "Eliminar componente PC (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/productos/componentes/{{idProductoComponente}}" }
        },
        {
          "name": "Listar traducciones de un producto",
          "request": { "method": "GET", "url": "{{baseUrl}}/productos/{{idProducto}}/traducciones" }
        },
        {
          "name": "Crear traduccion (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/{{idProducto}}/traducciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idIdioma\": 2,\n  \"nombreTraducido\": \"Gaming Mouse\",\n  \"descripcionTraducida\": \"High precision gaming mouse\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idTraduccion', pm.response.json().idTraduccion);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar traduccion (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/productos/traducciones/{{idTraduccion}}",
            "body": { "mode": "raw", "raw": "{\n  \"descripcionTraducida\": \"Updated description\"\n}" }
          }
        },
        {
          "name": "Eliminar traduccion (admin)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/productos/traducciones/{{idTraduccion}}" }
        }
      ]
    },
    {
      "name": "Idiomas",
      "item": [
        { "name": "Listar idiomas", "request": { "method": "GET", "url": "{{baseUrl}}/idiomas" } },
        {
          "name": "Crear idioma (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/idiomas",
            "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"pt\",\n  \"nombre\": \"Portugues\"\n}" }
          }
        },
        {
          "name": "Actualizar idioma (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/idiomas/3",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Portugues (Brasil)\"\n}" }
          }
        },
        { "name": "Eliminar idioma (admin)", "request": { "method": "DELETE", "url": "{{baseUrl}}/idiomas/3" } }
      ]
    },
    {
      "name": "Carrito",
      "item": [
        { "name": "Ver mi carrito", "request": { "method": "GET", "url": "{{baseUrl}}/carrito" } },
        {
          "name": "Agregar item al carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/carrito/items",
            "body": { "mode": "raw", "raw": "{\n  \"idProducto\": {{idProducto}},\n  \"cantidad\": 1\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const items = pm.response.json().items;",
                  "  if (items && items.length) {",
                  "    pm.collectionVariables.set('idItemCarrito', items[items.length - 1].idItemCarrito);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar cantidad de un item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/carrito/items/{{idItemCarrito}}",
            "body": { "mode": "raw", "raw": "{\n  \"cantidad\": 2\n}" }
          }
        },
        {
          "name": "Eliminar item del carrito",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/carrito/items/{{idItemCarrito}}" }
        },
        { "name": "Vaciar carrito", "request": { "method": "DELETE", "url": "{{baseUrl}}/carrito" } }
      ]
    },
    {
      "name": "Ventas",
      "item": [
        {
          "name": "Crear venta desde el carrito",
          "request": { "method": "POST", "url": "{{baseUrl}}/ventas" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idVenta', pm.response.json().idVenta);",
                  "}"
                ]
              }
            }
          ]
        },
        { "name": "Listar mis ventas", "request": { "method": "GET", "url": "{{baseUrl}}/ventas/mias" } },
        { "name": "Listar todas las ventas (admin)", "request": { "method": "GET", "url": "{{baseUrl}}/ventas" } },
        { "name": "Obtener venta por id", "request": { "method": "GET", "url": "{{baseUrl}}/ventas/{{idVenta}}" } },
        {
          "name": "Cambiar estado de venta (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/ventas/{{idVenta}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"PAGADA\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Solicitudes de servicio",
      "item": [
        {
          "name": "Crear solicitud",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/solicitudes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"La PC no enciende, tira dos beeps\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idSolicitud', pm.response.json().idSolicitud);",
                  "}"
                ]
              }
            }
          ]
        },
        { "name": "Listar mis solicitudes", "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes/mias" } },
        {
          "name": "Listar todas las solicitudes (admin)",
          "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes" }
        },
        {
          "name": "Obtener solicitud por id",
          "request": { "method": "GET", "url": "{{baseUrl}}/solicitudes/{{idSolicitud}}" }
        },
        {
          "name": "Cambiar estado de solicitud (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/solicitudes/{{idSolicitud}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PROCESO\",\n  \"diagnosticoIA\": \"Posible falla en la fuente de poder\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Presets",
      "item": [
        {
          "name": "Crear preset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/presets",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Mi PC Gamer\",\n  \"potenciaWatts\": 550\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('idPreset', pm.response.json().idPreset);",
                  "}"
                ]
              }
            }
          ]
        },
        { "name": "Listar mis presets", "request": { "method": "GET", "url": "{{baseUrl}}/presets/mios" } },
        { "name": "Obtener preset por id", "request": { "method": "GET", "url": "{{baseUrl}}/presets/{{idPreset}}" } },
        {
          "name": "Agregar componente al preset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/presets/{{idPreset}}/componentes",
            "body": { "mode": "raw", "raw": "{\n  \"idProducto\": {{idProductoComponente}}\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const comps = pm.response.json().componentes;",
                  "  if (comps && comps.length) {",
                  "    pm.collectionVariables.set('idComponentePreset', comps[comps.length - 1].idComponentePreset);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar componente del preset",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/presets/{{idPreset}}/componentes/{{idComponentePreset}}"
          }
        },
        { "name": "Eliminar preset", "request": { "method": "DELETE", "url": "{{baseUrl}}/presets/{{idPreset}}" } }
      ]
    },
    {
      "name": "Favoritos",
      "item": [
        { "name": "Listar mis favoritos", "request": { "method": "GET", "url": "{{baseUrl}}/favoritos" } },
        {
          "name": "Agregar favorito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
