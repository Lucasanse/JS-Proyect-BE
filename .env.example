# Puerto del servidor
PORT=3000

# Conexion a PostgreSQL (el docker-compose expone el puerto 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/js_db?schema=public"

# URL del frontend que puede llamar a la API (CORS)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los tokens JWT (usar un texto largo y aleatorio)
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRES_IN=1d
