DATABASE_URL="postgresql://postgres:postgres@localhost:5433/js_db?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Cualquier texto largo y aleatorio
BETTER_AUTH_SECRET=cambiar-por-un-texto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# IA para autocompletar productos a partir de fotos
# IA_PROVEEDOR: gemini (analiza las fotos de verdad) o mock (respuesta fija, sin key)
IA_PROVEEDOR=mock
# Key gratis de https://aistudio.google.com (Get API key). No subirla al repo.
IA_API_KEY=
IA_MODELO=gemini-3.5-flash-lite
# Si el modelo principal esta saturado se reintenta con este (opcional)
IA_MODELO_RESPALDO=gemini-3.1-flash-lite
# Opcional: forzar la IP de esta PC para el QR del celular (ej. 192.168.1.50)
IP_LOCAL=
